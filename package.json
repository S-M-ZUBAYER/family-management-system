{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "security:audit": "node scripts/audit-tenant-scope.mjs",
    "cancellation:audit": "node scripts/audit-mutation-cancellations.mjs",
    "test:privacy": "node scripts/test-member-privacy.mjs",
    "test:notifications": "node scripts/test-notification-visibility.mjs",
    "test:feedback": "node scripts/test-action-feedback.mjs",
    "test:qurbani": "node scripts/test-qurbani-policy.mjs",
    "test:qurbani-action-copy": "node scripts/test-qurbani-action-copy.mjs",
    "test:qurbani-validation": "node scripts/test-qurbani-validation.mjs",
    "test:qurbani-money-total": "node scripts/test-qurbani-money-total.mjs",
    "test:qurbani-distribution-totals": "node scripts/test-qurbani-distribution-totals.mjs",
    "test:qurbani-payment-reconciliation": "node scripts/test-qurbani-payment-reconciliation.mjs",
    "test:pagination": "node scripts/test-paginated-rows.mjs",
    "test:welfare-visibility": "node scripts/test-welfare-visibility.mjs",
    "test:governance-visibility": "node scripts/test-governance-visibility.mjs",
    "test:chat-unread": "node scripts/test-chat-unread-counts.mjs",
    "test:chat-cursor": "node scripts/test-chat-cursor.mjs",
    "test:chat-access": "node scripts/test-chat-access-policy.mjs",
    "test:admin-audit": "node scripts/test-admin-audit-visibility.mjs",
    "test:archive-access": "node scripts/test-archive-access.mjs",
    "test:event-media-access": "node scripts/test-event-media-access.mjs",
    "test:welfare-documents": "node scripts/test-welfare-document-policy.mjs",
    "test:finance-validation": "node scripts/test-personal-finance-validation.mjs",
    "test:family-selection": "node scripts/test-family-selection.mjs",
    "test:health-directory": "node scripts/test-health-directory-visibility.mjs",
    "i18n:audit": "node scripts/audit-translations.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
